{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run GPX Studio",
            "type": "shell",
            "command": ".venv_new/Scripts/python.exe",
            "args": [
                "main.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Install Dependencies",
            "type": "shell",
            "command": ".venv_new/Scripts/pip.exe",
            "args": [
                "install",
                "-r",
                "requirements.txt"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Test Services",
            "type": "shell",
            "command": ".venv_new/Scripts/python.exe",
            "args": [
                "test_services.py"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Update Requirements",
            "type": "shell",
            "command": ".venv_new/Scripts/pip.exe",
            "args": [
                "freeze"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean Cache",
            "type": "shell",
            "command": "for",
            "args": [
                "/R",
                "%~dp0",
                "%i",
                "in",
                "(__pycache__)",
                "do",
                "rd",
                "/s",
                "/q",
                "%i"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/c"
                    ]
                }
            }
        }
    ]
}