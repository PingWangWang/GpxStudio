{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: GPX Studio (推荐)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv_new/Scripts/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false,
            "redirectOutput": true
        },
        {
            "name": "Python: GPX Studio (外部终端)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "externalTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv_new/Scripts/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false
        },
        {
            "name": "Python: 调试测试",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_test.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv_new/Scripts/python.exe",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false,
            "redirectOutput": true
        }
    ]
}