{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: GPX Studio",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "pythonPath": "${command:python.interpreterPath}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false,
            "redirectOutput": true,
            "redirectInput": true
        },
        {
            "name": "Python: GPX Studio (External Terminal)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "externalTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false
        },
        {
            "name": "Python: Debug Core Module",
            "type": "python",
            "request": "launch",
            "module": "core.app",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false,
            "redirectOutput": true
        },
        {
            "name": "Python: Debug Services",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/test_services.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
            },
            "stopOnEntry": false,
            "redirectOutput": true
        }
    ]
}